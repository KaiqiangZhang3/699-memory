{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tiered-memory.local/schemas/v1/daily_log.schema.json",
  "title": "Daily Log entry (L tier)",
  "description": "Append-only chronological evidence of events, commands, changes, validation and timestamps (Glossary). Entries are never edited; a correction is a new entry that points to the one it corrects.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "tier", "project_id", "entry_id", "log_date", "sequence", "recorded_at_utc",
    "event_id", "dedup_key", "entry_type", "summary", "evidence", "content_hash", "prev_entry_hash", "provenance"
  ],
  "properties": {
    "schema_version": { "const": "dl-v1" },
    "tier": { "const": "daily_log" },
    "project_id": { "$ref": "common.schema.json#/$defs/project_id" },
    "entry_id": { "$ref": "common.schema.json#/$defs/entry_id" },
    "log_date": { "$ref": "common.schema.json#/$defs/utc_date", "description": "UTC date; one log file per date." },
    "sequence": { "type": "integer", "minimum": 1, "description": "1, 2, 3 ... within log_date; gaps are an audit failure." },
    "recorded_at_utc": { "$ref": "common.schema.json#/$defs/utc_timestamp" },
    "event_id": { "$ref": "common.schema.json#/$defs/event_id" },
    "dedup_key": { "type": "string", "pattern": "^[0-9a-f]{64}$", "description": "Same key as the queued candidate; a retry must not create a second entry (QR2)." },
    "run_id": { "anyOf": [{ "$ref": "common.schema.json#/$defs/run_id" }, { "type": "null" }] },
    "task_id": { "anyOf": [{ "$ref": "common.schema.json#/$defs/task_id" }, { "type": "null" }] },
    "session_id": { "anyOf": [{ "$ref": "common.schema.json#/$defs/session_id" }, { "type": "null" }] },
    "entry_type": {
      "enum": ["command", "test_result", "code_change", "decision", "failure", "user_correction", "session_boundary", "maintenance", "note"]
    },
    "summary": { "$ref": "common.schema.json#/$defs/nonempty_text" },
    "evidence": { "type": "array", "minItems": 1, "items": { "$ref": "common.schema.json#/$defs/evidence_ref" } },
    "corrects_entry_id": { "anyOf": [{ "$ref": "common.schema.json#/$defs/entry_id" }, { "type": "null" }] },
    "content_hash": { "$ref": "common.schema.json#/$defs/sha256" },
    "prev_entry_hash": {
      "anyOf": [{ "$ref": "common.schema.json#/$defs/sha256" }, { "type": "null" }],
      "description": "content_hash of the previous entry for the same log_date (null only for sequence 1). Makes silent edits or deletions detectable."
    },
    "provenance": {
      "allOf": [
        { "$ref": "common.schema.json#/$defs/provenance" },
        { "properties": { "operation": { "const": "append" } } }
      ]
    }
  },
  "allOf": [
    {
      "if": { "properties": { "sequence": { "const": 1 } } },
      "then": { "properties": { "prev_entry_hash": { "type": "null" } } },
      "else": { "properties": { "prev_entry_hash": { "$ref": "common.schema.json#/$defs/sha256" } } }
    }
  ]
}
