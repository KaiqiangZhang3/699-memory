{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tiered-memory.local/schemas/v1/event_case.schema.json",
  "title": "Memory-event case (Stage One)",
  "description": "One replayable case: a starting memory state plus one observed event (proposal 4.5, 4.10). The reference answer is NOT stored here; labels live in separate label files so they can be made independently (4.14).",
  "type": "object",
  "additionalProperties": false,
  "required": ["case_version", "case_id", "set", "family", "title", "purpose", "fixture", "starting_memory", "event"],
  "properties": {
    "case_version": { "const": "case-v1" },
    "case_id": { "type": "string", "pattern": "^(dev|formal)-F(0[1-9]|10)-[0-9]{2}$" },
    "set": { "enum": ["dev", "formal"] },
    "family": { "$ref": "common.schema.json#/$defs/event_family" },
    "title": { "type": "string", "minLength": 1, "maxLength": 120 },
    "purpose": { "type": "string", "minLength": 1, "description": "What the case probes. Written for the case author, never shown to the system." },
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "initial_commit"],
      "properties": {
        "path": { "type": "string" },
        "initial_commit": { "$ref": "common.schema.json#/$defs/git_commit" }
      }
    },
    "starting_memory": {
      "type": "array",
      "description": "Records created, in order, before the event is replayed. Each seed goes through the Versioned Writer like any other write.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ref", "tier", "payload"],
        "properties": {
          "ref": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,39}$", "description": "Name used by labels to point at this record." },
          "tier": { "$ref": "common.schema.json#/$defs/tier" },
          "payload": { "type": "object", "description": "VersionedWriter payload. Evidence may use the short form {label, kind, locator, outcome?}; '$EVENT_DEDUP_KEY' is replaced by the case event's dedup key." }
        }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hook_event_type", "observed_at_utc", "task_id", "session_label", "source", "content"],
      "properties": {
        "hook_event_type": { "$ref": "common.schema.json#/$defs/hook_event_type" },
        "observed_at_utc": { "$ref": "common.schema.json#/$defs/utc_timestamp" },
        "task_id": { "anyOf": [{ "$ref": "common.schema.json#/$defs/task_id" }, { "type": "null" }] },
        "session_label": { "type": "string", "minLength": 1, "description": "Stable label; the session_id is derived from it." },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "locator"],
          "properties": {
            "kind": { "$ref": "common.schema.json#/$defs/evidence_kind" },
            "locator": { "type": "string", "minLength": 1 },
            "command": { "type": ["string", "null"] },
            "exit_code": { "type": ["integer", "null"] },
            "outcome": { "enum": ["pass", "fail", "error", "skipped", null] }
          }
        },
        "content": { "type": "string", "minLength": 1, "maxLength": 8000, "description": "What the Hook observed (output, diff, message). Synthetic; dummy secrets only." }
      }
    }
  }
}
